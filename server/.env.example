# Arkanoid's slot in the Liquid Galaxy game port family: pong 8112,
# snake 8114, pacman 8128, asteroids 8129, lg-retro-gaming launcher 3123.
PORT=8130

# Screens on the wall. Left blank/absent, the launcher reads
# DHCP_LG_FRAMES_MAX from /lg/personavars.txt instead.
NUM_SCREENS=3

LG_PASSWORD=lq
GEMINI_API_KEY=your_key_here

# Frame aspect override. Stock LG rigs set DHCP_RANDR=right, which makes each
# frame portrait, and the launcher follows that automatically. Set this only for
# unrotated panels or desk testing: 16:9 (landscape) or 9:16 (portrait).
LG_FRAME_ASPECT=

# Pin the IPv4 phones should use in the wall QR if getLanIp() picks the wrong NIC.
# LG_HOST_IP=192.168.1.10

