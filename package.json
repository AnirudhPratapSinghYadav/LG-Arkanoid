{
  "name": "lg-arkanoid",
  "version": "1.0.0",
  "private": true,
  "description": "LG Arkanoid Game with Phaser.js, Express, Socket.IO and Vite Live Reload Server",
  "workspaces": [
    "server",
    "web-client"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "npm run start --workspace=server",
    "start": "concurrently --names \"SERVER,VITE\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\"",
    "build": "vite build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^4.5.14"
  }
}
