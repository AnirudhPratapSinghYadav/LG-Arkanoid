{
  "name": "lg-arkanoid",
  "version": "1.0.0",
  "private": true,
  "description": "LG Arkanoid Game with Phaser.js, Express, Socket.IO and Vite Live Reload Server",
  "workspaces": [
    "server",
    "web-client"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "npm run start --workspace=server",
    "start": "concurrently --names \"SERVER,VITE\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "test": "node server/tests/gameEngine.test.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^4.5.14"
  },
  "overrides": {
    "ws": "8.21.3",
    "tar-fs": "3.1.3"
  }
}
