# Server Configuration
# 8130 = Arkanoid's slot in the LG game port family (pong 8112, snake 8114,
# pacman 8128, asteroids 8129; lg-retro-gaming launcher 3123).
PORT=8130

# Liquid Galaxy Rig Configuration
# Stock rigs use 'lq' for the lg user (lg-retro-gaming assumes it).
LG_PASSWORD=lq
NUM_SCREENS=3

# Frame aspect override. Left blank the game follows the rig's own DHCP_RANDR,
# which is 'right' (portrait frames) on a stock install. Use 16:9 or 9:16.
LG_FRAME_ASPECT=

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here
